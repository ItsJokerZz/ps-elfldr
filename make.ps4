PS4_HOST ?= ps4
PS4_PORT ?= 9020

ifdef PS4_PAYLOAD_SDK
    include $(PS4_PAYLOAD_SDK)/toolchain/orbis.mk
else
    $(error PS4_PAYLOAD_SDK is undefined)
endif

ELF := $(BUILD)/elfldr-ps4.elf
BIN := $(BUILD)/elfldr-ps4.bin

CFLAGS := -fPIC -Wall -Werror -g -mstackrealign

all: $(ELF) $(BIN)

$(BUILD)/socksrv.elf: $(addprefix $(BUILD)/,socksrv.o elfldr.o elfldr_shared.o uri.o selfldr.o notify.o) $(PTRACE)
	$(CC) $(CFLAGS) -lSceSsl -lSceHttp $^ -o $@

$(BUILD)/elfldr.o: ps4/elfldr.c
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/elfldr_shared.o: shared/elfldr.c
	$(CC) $(CFLAGS) -c $< -o $@


$(BUILD)/bootstrap.o: ps4/bootstrap.c $(BUILD)/socksrv.elf
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/bootstrap.elf: $(addprefix $(BUILD)/,bootstrap.o elfldr.o elfldr_shared.o notify.o) $(PTRACE)
	$(CC) $(CFLAGS) $^ -o $@

$(BUILD)/main.o: ps4/main.c $(BUILD)/bootstrap.elf
	$(CC) $(CFLAGS) -c $< -o $@

$(ELF): $(addprefix $(BUILD)/,main.o elfldr.o elfldr_shared.o notify.o) $(PTRACE)
	$(CC) $(CFLAGS) $^ -o $@

$(BUILD)/bootstrap-bin.o: $(ELF)

$(BIN): $(BUILD)/bootstrap-bin.o
	$(LD) -T ps4/bin_x86_64.x -o $@ $<
	$(OBJCOPY) -O binary --only-section=.text $@

test: $(ELF)
	$(PS4_DEPLOY) -h $(PS4_HOST) -p $(PS4_PORT) $^
