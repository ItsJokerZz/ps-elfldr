PS5_HOST ?= ps5
PS5_PORT ?= 9020

ifdef PS5_PAYLOAD_SDK
    include $(PS5_PAYLOAD_SDK)/toolchain/prospero.mk
else
    $(error PS5_PAYLOAD_SDK is undefined)
endif

ELF := $(BUILD)/elfldr-ps5.elf

CFLAGS := -Wall -Werror -O1
LDADD  := -lSceSsl -lSceHttp

all: $(ELF)

$(BUILD)/elfldr.o: ps5/elfldr.c
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/elfldr_shared.o: shared/elfldr.c
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/bootstrap.o: ps5/bootstrap.c $(BUILD)/socksrv.elf
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/main.o: ps5/main.c $(BUILD)/bootstrap.elf
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/bootstrap.elf: $(addprefix $(BUILD)/,bootstrap.o elfldr.o elfldr_shared.o notify.o) $(PTRACE)
	$(CC) -o $@ $^
	$(STRIP) $@

$(BUILD)/socksrv.elf: $(addprefix $(BUILD)/,socksrv.o selfldr.o elfldr.o elfldr_shared.o notify.o uri.o) $(PTRACE)
	$(CC) -o $@ $^ $(LDADD)
	$(STRIP) $@

$(ELF): $(addprefix $(BUILD)/,main.o elfldr.o elfldr_shared.o notify.o) $(PTRACE)
	$(CC) -o $@ $^
	$(STRIP) $@

test: $(ELF)
	$(PS5_DEPLOY) -h $(PS5_HOST) -p $(PS5_PORT) $^

.INTERMEDIATE: $(BUILD)/socksrv.elf $(BUILD)/bootstrap.elf
